// Diagramme de classes - DR-DOCSCOL (soutenance)
// Rendu noir sur blanc, liaisons orthogonales (splines=ortho), via Kroki/Graphviz.
digraph DiagrammeClasses {
  graph [rankdir=TB, splines=ortho, bgcolor=white, nodesep=0.55, ranksep=1.0,
         fontname="Arial", fontsize=12, labelloc=t,
         label="Diagramme de classes - DR-DOCSCOL"];
  node [shape=plaintext, fontname="Arial", fontsize=12, fontcolor=black, color=black];
  edge [fontname="Arial", fontsize=11, color=black, fontcolor=black, arrowsize=0.8];

  // ===================== CLASSES =====================
  Utilisateur [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Utilisateur</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ email : String<BR ALIGN="LEFT"/>+ matricule : String<BR ALIGN="LEFT"/>+ nom : String<BR ALIGN="LEFT"/>+ prenom : String<BR ALIGN="LEFT"/>+ role : Role<BR ALIGN="LEFT"/>+ derniereConnexion : DateTime</TD></TR>
    </TABLE>>];

  Eleve [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Eleve</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ dateNaissance : DateTime</TD></TR>
    </TABLE>>];

  Administrateur [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Administrateur</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ nomService : String<BR ALIGN="LEFT"/>+ maxRdvParJour : Int</TD></TR>
    </TABLE>>];

  AgentCentreExamen [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>AgentCentreExamen</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ centreExamenId : String</TD></TR>
    </TABLE>>];

  Organisme [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Organisme</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ nom : String</TD></TR>
    </TABLE>>];

  AntenneRegionale [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>AntenneRegionale</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ nom : String<BR ALIGN="LEFT"/>+ region : String<BR ALIGN="LEFT"/>+ ville : String</TD></TR>
    </TABLE>>];

  CentreExamen [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>CentreExamen</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ nom : String<BR ALIGN="LEFT"/>+ region : String<BR ALIGN="LEFT"/>+ ville : String</TD></TR>
    </TABLE>>];

  ExamenValide [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>ExamenValide</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ diplomeType : DiplomePrincipal<BR ALIGN="LEFT"/>+ anneeSession : Int<BR ALIGN="LEFT"/>+ regionComposition : String</TD></TR>
    </TABLE>>];

  DocumentAcademique [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>DocumentAcademique</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ typeDocument : TypeDocument<BR ALIGN="LEFT"/>+ diplomeType : DiplomePrincipal<BR ALIGN="LEFT"/>+ statut : StatutDocument<BR ALIGN="LEFT"/>+ demandeSoumiseAt : DateTime</TD></TR>
    </TABLE>>];

  Duplicata [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Duplicata</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ typeDocument : TypeDocument<BR ALIGN="LEFT"/>+ nomDuplicata : String<BR ALIGN="LEFT"/>+ statut : StatutDocument<BR ALIGN="LEFT"/>+ statutValidation : StatutValidationDuplicata</TD></TR>
    </TABLE>>];

  PieceDuplicata [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>PieceDuplicata</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ typePiece : TypePieceDuplicata<BR ALIGN="LEFT"/>+ statut : StatutPieceDuplicata<BR ALIGN="LEFT"/>+ fileName : String</TD></TR>
    </TABLE>>];

  Releve [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Releve</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ nomReleve : String<BR ALIGN="LEFT"/>+ statut : StatutDocument</TD></TR>
    </TABLE>>];

  Diplome [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Diplome</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ nomDiplome : String<BR ALIGN="LEFT"/>+ statut : StatutDocument</TD></TR>
    </TABLE>>];

  Paiement [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Paiement</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ statut : StatutPaiement<BR ALIGN="LEFT"/>+ modePaiement : String</TD></TR>
    </TABLE>>];

  Recu [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Recu</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ numero : String<BR ALIGN="LEFT"/>+ montant : Float<BR ALIGN="LEFT"/>+ dateEmission : DateTime</TD></TR>
    </TABLE>>];

  RendezVous [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>RendezVous</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ dateRdv : DateTime<BR ALIGN="LEFT"/>+ heureRdv : String<BR ALIGN="LEFT"/>+ lieu : String<BR ALIGN="LEFT"/>+ statut : StatutRendezVous</TD></TR>
    </TABLE>>];

  DisponibiliteRdv [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>DisponibiliteRdv</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ dateRdv : DateTime<BR ALIGN="LEFT"/>+ heureRdv : String<BR ALIGN="LEFT"/>+ statut : StatutDisponibilite</TD></TR>
    </TABLE>>];

  Notification [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>Notification</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ typeNotification : String<BR ALIGN="LEFT"/>+ statut : StatutNotification<BR ALIGN="LEFT"/>+ message : String</TD></TR>
    </TABLE>>];

  MailLog [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>MailLog</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ destinataire : String<BR ALIGN="LEFT"/>+ sujet : String<BR ALIGN="LEFT"/>+ statut : String</TD></TR>
    </TABLE>>];

  AuditLog [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="CENTER"><B>AuditLog</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ id : String<BR ALIGN="LEFT"/>+ action : String<BR ALIGN="LEFT"/>+ resource : String<BR ALIGN="LEFT"/>+ resourceId : String</TD></TR>
    </TABLE>>];

  // ===================== HERITAGE (generalisation) =====================
  edge [dir=back, arrowtail=empty, arrowhead=none];
  Utilisateur -> Eleve;
  Utilisateur -> Administrateur;
  Utilisateur -> AgentCentreExamen;

  // ===================== ASSOCIATIONS =====================
  edge [dir=forward, arrowtail=none, arrowhead=vee];

  // Organisation institutionnelle
  Organisme -> AntenneRegionale [label="possede", taillabel="1", headlabel="0..*"];
  Organisme -> Administrateur [label="emploie", taillabel="1", headlabel="0..*"];
  Organisme -> DocumentAcademique [label="supervise", taillabel="1", headlabel="0..*"];
  Organisme -> Duplicata [label="supervise", taillabel="1", headlabel="0..*"];
  AntenneRegionale -> Administrateur [label="affecte", taillabel="1", headlabel="0..*"];
  AntenneRegionale -> DocumentAcademique [label="gere le retrait", taillabel="1", headlabel="0..*"];
  AntenneRegionale -> Duplicata [label="gere le retrait", taillabel="1", headlabel="0..*"];
  CentreExamen -> AgentCentreExamen [label="affecte", taillabel="1", headlabel="0..*"];

  // Actions de l'eleve
  Eleve -> ExamenValide [label="a reussi", taillabel="1", headlabel="0..*"];
  Eleve -> DocumentAcademique [label="demande", taillabel="1", headlabel="0..*"];
  Eleve -> Duplicata [label="demande", taillabel="1", headlabel="0..*"];
  Eleve -> RendezVous [label="prend", taillabel="1", headlabel="0..*"];
  Eleve -> Notification [label="recoit", taillabel="1", headlabel="0..*"];
  Eleve -> Recu [label="possede", taillabel="1", headlabel="0..*"];

  // Actions de l'administrateur
  Administrateur -> DisponibiliteRdv [label="ouvre", taillabel="1", headlabel="0..*"];
  Administrateur -> RendezVous [label="planifie", taillabel="1", headlabel="0..*"];
  Administrateur -> Duplicata [label="analyse", taillabel="1", headlabel="0..*"];
  Administrateur -> PieceDuplicata [label="valide", taillabel="1", headlabel="0..*"];

  // Actions de l'agent
  AgentCentreExamen -> RendezVous [label="confirme le retrait", taillabel="1", headlabel="0..*"];

  // Cycle de vie des documents
  DocumentAcademique -> RendezVous [label="fait l'objet de", taillabel="1", headlabel="0..*"];
  DocumentAcademique -> Releve [label="contient", taillabel="1", headlabel="0..1"];
  DocumentAcademique -> Diplome [label="contient", taillabel="1", headlabel="0..1"];
  DocumentAcademique -> Paiement [label="genere", taillabel="1", headlabel="0..1"];
  Duplicata -> Releve [label="concerne", taillabel="1", headlabel="0..1"];
  Duplicata -> Diplome [label="concerne", taillabel="1", headlabel="0..1"];
  Duplicata -> Paiement [label="exige", taillabel="1", headlabel="1"];
  Duplicata -> PieceDuplicata [label="comporte", taillabel="1", headlabel="0..*"];

  // Paiement et rendez-vous
  Paiement -> Recu [label="genere", taillabel="1", headlabel="0..*"];
  DisponibiliteRdv -> RendezVous [label="reserve", taillabel="1", headlabel="0..1"];

  // Journalisation
  Utilisateur -> MailLog [label="recoit", taillabel="1", headlabel="0..*"];
  Utilisateur -> AuditLog [label="genere", taillabel="1", headlabel="0..*"];
}
