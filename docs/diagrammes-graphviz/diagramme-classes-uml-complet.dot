// Diagramme de classes UML complet - DR-DOCSCOL
// Notation : + public, - prive | generalisation | composition (◆) | aggregation (◇)
digraph DiagrammeClassesUML {
  graph [
    rankdir=TB
    splines=ortho
    bgcolor=white
    nodesep=0.65
    ranksep=1.05
    fontname="Arial"
    fontsize=11
    labelloc=t
    label="Diagramme de classes UML — DR-DOCSCOL\n(OBC / DECC — retrait de documents scolaires)"
  ];
  node [shape=plaintext, fontname="Arial", fontsize=10, fontcolor=black, color=black];
  edge [fontname="Arial", fontsize=9, color=black, fontcolor=black, penwidth=1.0];

  // ===================== CLASSES (3 compartiments) =====================

  Utilisateur [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>«abstract» Utilisateur</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        - authUserId : String<BR/>
        + email : String<BR/>
        + matricule : String<BR/>
        + nom : String<BR/>
        + prenom : String<BR/>
        + role : Role<BR/>
        - dateCreation : DateTime<BR/>
        + derniereConnexion : DateTime
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + seConnecter(email, motDePasse) : Session<BR/>
        + getRole() : Role<BR/>
        # mettreAJourDerniereConnexion() : void
      </TD></TR>
    </TABLE>>];

  Eleve [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Eleve</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ dateNaissance : DateTime</TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + activerCompte() : void<BR/>
        + consulterDocuments() : DocumentAcademique[]<BR/>
        + demanderReleve(diplome : DiplomePrincipal) : void<BR/>
        + demanderDuplicata(dossier : DossierDuplicata) : void<BR/>
        + prendreRendezVous(document, date, heure) : RendezVous<BR/>
        + annulerRendezVous(rdv : RendezVous) : void
      </TD></TR>
    </TABLE>>];

  Administrateur [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Administrateur</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + nomService : String<BR/>
        + maxRdvParJour : Int<BR/>
        - organismeId : String<BR/>
        - antenneRegionaleId : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + importerEleves(csv : File) : ResultatImport<BR/>
        + disponibiliserDocument(doc : DocumentAcademique) : void<BR/>
        + changerStatut(doc, statut : StatutDocument) : void<BR/>
        + analyserDuplicata(dup : Duplicata) : void<BR/>
        + validerPiece(piece : PieceDuplicata) : void
      </TD></TR>
    </TABLE>>];

  AgentCentreExamen [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>AgentCentreExamen</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">- centreExamenId : String</TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + listerRendezVousDuCentre() : RendezVous[]<BR/>
        + confirmerRetrait(rdv : RendezVous) : void
      </TD></TR>
    </TABLE>>];

  Organisme [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Organisme</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + nom : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ getAntennes() : AntenneRegionale[]</TD></TR>
    </TABLE>>];

  AntenneRegionale [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>AntenneRegionale</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + nom : String<BR/>
        + region : String<BR/>
        + ville : String<BR/>
        - organismeId : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ getAccessKey() : String</TD></TR>
    </TABLE>>];

  CentreExamen [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>CentreExamen</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + nom : String<BR/>
        + region : String<BR/>
        + ville : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ getAgents() : AgentCentreExamen[]</TD></TR>
    </TABLE>>];

  ExamenValide [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>ExamenValide</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + diplomeType : DiplomePrincipal<BR/>
        + anneeSession : Int<BR/>
        + centreExamen : String<BR/>
        + regionComposition : String<BR/>
        - eleveId : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ estCompose(diplome : DiplomePrincipal) : boolean</TD></TR>
    </TABLE>>];

  DocumentAcademique [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>DocumentAcademique</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + typeDocument : TypeDocument<BR/>
        + diplomeType : DiplomePrincipal<BR/>
        + statut : StatutDocument<BR/>
        + demandeSoumiseAt : DateTime<BR/>
        + centreExamen : String<BR/>
        + regionComposition : String<BR/>
        - eleveId : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + appliquerTransition(statut : StatutDocument) : void<BR/>
        - resoudreRoute() : RouteDocument<BR/>
        + necessiteRendezVous() : boolean
      </TD></TR>
    </TABLE>>];

  Duplicata [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Duplicata</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + typeDocument : TypeDocument<BR/>
        + nomDuplicata : String<BR/>
        + statut : StatutDocument<BR/>
        + statutValidation : StatutValidationDuplicata<BR/>
        + motifRejet : String<BR/>
        - eleveId : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + soumettrePieces(fichiers : File[]) : void<BR/>
        + calculerFrais() : Float<BR/>
        + synchroniserStatutDocument() : void
      </TD></TR>
    </TABLE>>];

  PieceDuplicata [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>PieceDuplicata</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + typePiece : TypePieceDuplicata<BR/>
        + statut : StatutPieceDuplicata<BR/>
        - bucket : String<BR/>
        - path : String<BR/>
        + fileName : String<BR/>
        - duplicataId : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + televerser(fichier : File) : void<BR/>
        + valider(admin : Administrateur) : void
      </TD></TR>
    </TABLE>>];

  Paiement [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Paiement</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + statut : StatutPaiement<BR/>
        + modePaiement : modePaiement<BR/>
        - duplicataId : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + effectuerPaiement() : Recu<BR/>
        + confirmerWebhook(ref : String) : void
      </TD></TR>
    </TABLE>>];

  Recu [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Recu</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + numero : String<BR/>
        + montant : Float<BR/>
        + dateEmission : DateTime<BR/>
        + modePaiement : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ genererPDF() : Blob</TD></TR>
    </TABLE>>];

  Releve [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Releve</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + nomReleve : String<BR/>
        + statut : StatutDocument<BR/>
        + instruction : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ marquerDisponible() : void</TD></TR>
    </TABLE>>];

  Diplome [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Diplome</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + nomDiplome : String<BR/>
        + statut : StatutDocument<BR/>
        + instruction : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ marquerDisponible() : void</TD></TR>
    </TABLE>>];

  RendezVous [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>RendezVous</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + dateRdv : DateTime<BR/>
        + heureRdv : String<BR/>
        + lieu : String<BR/>
        + statut : StatutRendezVous<BR/>
        + commentaire : String<BR/>
        + retraitConfirmeAt : DateTime
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + planifier() : void<BR/>
        + annuler() : void<BR/>
        + confirmerRetrait(agent : AgentCentreExamen) : void
      </TD></TR>
    </TABLE>>];

  DisponibiliteRdv [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>DisponibiliteRdv</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + dateRdv : DateTime<BR/>
        + heureRdv : String<BR/>
        + lieu : String<BR/>
        + statut : StatutDisponibilite
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ reserver() : RendezVous</TD></TR>
    </TABLE>>];

  Notification [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>Notification</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + typeNotification : String<BR/>
        + title : String<BR/>
        + statut : StatutNotification<BR/>
        + message : String<BR/>
        + actionUrl : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        + marquerCommeLue() : void<BR/>
        + envoyerEmail() : void
      </TD></TR>
    </TABLE>>];

  AuditLog [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>AuditLog</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + action : String<BR/>
        + resource : String<BR/>
        + resourceId : String<BR/>
        + details : String<BR/>
        + ipAddress : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ enregistrer(action, resource) : void</TD></TR>
    </TABLE>>];

  MailLog [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="CENTER"><B>MailLog</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT">
        - id : String<BR/>
        + to : String<BR/>
        + subject : String<BR/>
        + status : String<BR/>
        + error : String
      </TD></TR><HR/>
      <TR><TD ALIGN="LEFT">+ journaliser(envoi : Email) : void</TD></TR>
    </TABLE>>];

  // ===================== RANGS (eviter entremelement) =====================
  { rank=same; Utilisateur; }
  { rank=same; Eleve; Administrateur; AgentCentreExamen; }
  { rank=same; Organisme; CentreExamen; }
  { rank=same; AntenneRegionale; ExamenValide; }
  { rank=same; DocumentAcademique; Duplicata; }
  { rank=same; PieceDuplicata; Paiement; Releve; Diplome; }
  { rank=same; RendezVous; DisponibiliteRdv; Recu; }
  { rank=same; Notification; AuditLog; MailLog; }

  // ===================== GENERALISATION (heritage) =====================
  edge [dir=back, arrowtail=empty, arrowhead=none, penwidth=1.2];
  Utilisateur -> Eleve;
  Utilisateur -> Administrateur;
  Utilisateur -> AgentCentreExamen;

  // ===================== COMPOSITION (losange plein ◆ — cycle de vie lie) =====================
  edge [dir=forward, arrowtail=odiamond, arrowhead=vee, penwidth=1.0];

  Organisme -> AntenneRegionale [label=" 1      0..* "];
  Duplicata -> PieceDuplicata [label=" 1      0..* "];
  Duplicata -> Paiement [label=" 1      1 "];
  Paiement -> Recu [label=" 1      0..* "];
  DocumentAcademique -> RendezVous [label=" 1      0..* "];
  Eleve -> ExamenValide [label=" 1      0..* "];
  Eleve -> Notification [label=" 1      0..* "];

  // ===================== AGREGATION (losange vide ◇ — partage possible) =====================
  edge [dir=forward, arrowtail=diamond, arrowhead=vee, style=solid];

  Organisme -> Administrateur [label=" 1      0..* "];
  AntenneRegionale -> Administrateur [label=" 1      0..* "];
  CentreExamen -> AgentCentreExamen [label=" 1      0..* "];
  Organisme -> DocumentAcademique [label=" 1      0..* "];
  AntenneRegionale -> DocumentAcademique [label=" 1      0..* "];
  Organisme -> Duplicata [label=" 1      0..* "];
  AntenneRegionale -> Duplicata [label=" 1      0..* "];

  // ===================== ASSOCIATIONS SIMPLES =====================
  edge [dir=forward, arrowtail=none, arrowhead=vee];

  Eleve -> DocumentAcademique [label=" demande   1      0..* "];
  Eleve -> Duplicata [label=" demande   1      0..* "];
  Eleve -> RendezVous [label=" prend   1      0..* "];
  Eleve -> Recu [label=" possede   1      0..* "];
  Administrateur -> DisponibiliteRdv [label=" ouvre   1      0..* "];
  Administrateur -> RendezVous [label=" planifie   1      0..* "];
  Administrateur -> Duplicata [label=" analyse   1      0..* "];
  Administrateur -> PieceDuplicata [label=" valide   1      0..* "];
  AgentCentreExamen -> RendezVous [label=" confirme retrait   1      0..* "];
  DisponibiliteRdv -> RendezVous [label=" reserve   1      0..1 "];
  DocumentAcademique -> Releve [label=" contient   1      0..1 "];
  DocumentAcademique -> Diplome [label=" contient   1      0..1 "];
  DocumentAcademique -> Paiement [label=" genere   1      0..1 "];
  Duplicata -> Releve [label=" concerne   1      0..1 "];
  Duplicata -> Diplome [label=" concerne   1      0..1 "];
  Utilisateur -> MailLog [label=" recoit   1      0..* "];
  Utilisateur -> AuditLog [label=" genere   1      0..* "];
}
