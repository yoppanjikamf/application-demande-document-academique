%%{init: {"theme": "base", "themeVariables": {"darkMode": false, "background": "#ffffff", "mainBkg": "#ffffff", "secondaryBkg": "#ffffff", "tertiaryBkg": "#ffffff", "fontFamily": "Arial", "fontSize": "18px", "textColor": "#333333", "lineColor": "#333333", "signalColor": "#333333", "signalTextColor": "#333333"}}}%%
sequenceDiagram
    actor Eleve
    actor Admin as Administrateur OBC ou DECC
    participant Sys as Systeme DR-DOCSCOL
    participant DB as Base de donnees

    Eleve->>Sys: demander un duplicata
    Sys-->>Eleve: Afficher le formulaire(examen, document cible, motif, pieces, paiement)
    Eleve->>Sys: soumettre le formulaire et les justificatifs

    alt Donnees valides
        Sys->>DB: enregistrer la demande, les pieces et le paiement
        DB-->>Sys: confirmer l enregistrement
        Sys->>DB: notifier l eleve(demande enregistree)
        Sys-->>Eleve: confirmer la demande, afficher le recu et le statut En cours de traitement
    else Donnees invalides
        Sys-->>Eleve: afficher le message d erreur(pieces manquantes, delai non respecte ou autre demande en cours)
    end

    Admin->>Sys: examiner et valider les pieces du dossier
    alt Pieces conformes
        Sys->>DB: valider le dossier(statutValidation VALIDEE)
        DB-->>Sys: confirmer la validation
        Sys->>DB: notifier l eleve(dossier valide)
        Sys-->>Admin: confirmer la validation du dossier
    else Pieces non conformes
        Sys-->>Admin: afficher le message d erreur(dossier a corriger ou rejete)
    end

    Admin->>Sys: marquer le duplicata comme DISPONIBLE
    alt Dossier deja valide
        Sys->>DB: passer le duplicata a DISPONIBLE
        DB-->>Sys: confirmer la mise a jour
        Sys->>DB: notifier l eleve(duplicata pret, prendre rendez-vous)
        Sys-->>Admin: confirmer la disponibilite
    else Dossier non valide
        Sys-->>Admin: afficher le message d erreur(validation admin requise)
    end

    Eleve->>Sys: prendre un rendez-vous de retrait en antenne regionale
    alt Creneau disponible
        Sys->>DB: creer le rendez-vous PLANIFIE
        DB-->>Sys: confirmer la reservation
        Sys-->>Eleve: confirmer le rendez-vous(date, heure, lieu antenne)
    else Creneau indisponible
        Sys-->>Eleve: afficher le message d erreur(creneau ou document non disponible)
    end
