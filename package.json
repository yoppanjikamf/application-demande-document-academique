{
  "name": "nextjs-supabase-prisma-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:clean": "rm -rf .next && next dev -H 0.0.0.0",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && prisma generate && next build && node scripts/copy-prisma-engines.mjs",
    "test": "RATE_LIMIT_STORE=memory tsx --test tests/**/*.test.ts",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "export:disponibilisation-csv": "tsx scripts/export-disponibilisation-csv.ts",
    "reset:imports": "tsx scripts/reset-et-preparer-imports.ts",
    "test:imports": "tsx scripts/test-imports-csv.ts",
    "export:docs-pdf": "bash scripts/export-all-docs-pdf.sh",
    "seed:soutenance-eleves": "tsx scripts/seed-soutenance-eleves.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:centre-agents": "tsx scripts/seed-centre-examen-agents.ts",
    "seed:decc-admins": "tsx scripts/seed-decc-regional-admins.ts",
    "seed:regional-admins": "tsx scripts/seed-regional-admins.ts",
    "seed:test-auth": "tsx scripts/seed-auth-test-user.ts",
    "seed:appointments": "tsx scripts/seed-appointments.ts",
    "prisma:seed": "tsx scripts/seed-diplomes.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "diagrams:export-v3": "bash scripts/export-diagrams-v3.sh",
    "diagrams:classes-soutenance": "node scripts/generate-conform-diagrams.mjs --classes-soutenance",
    "diagrams:conform": "node scripts/generate-conform-diagrams.mjs",
    "diagrams:cas-utilisation": "node scripts/generate-cas-utilisation-all.mjs",
    "diagrams:cas-utilisation-admin": "node scripts/generate-cas-utilisation-diagram.mjs",
    "diagrams:sequences-generate": "node scripts/generate-sequence-diagrams-acteurs.mjs",
    "diagrams:sequences-acteurs": "node scripts/generate-sequence-diagrams-acteurs.mjs && bash scripts/export-sequences-acteurs.sh",
    "diagrams:activites": "node scripts/generate-activity-diagrams.mjs",
    "diagrams:architecture": "node scripts/generate-architecture-diagram.mjs",
    "diagrams:contexte-packages": "node scripts/generate-context-package-diagrams.mjs",
    "diagrams:classes-simple": "node scripts/generate-class-diagram-simple.mjs",
    "docs:soutenance-conception": "python3 scripts/build-cahier-conception-soutenance.py",
    "memoire:prepare": "tsx scripts/ensure-screenshot-eleve-auth.ts && tsx scripts/prepare-memoire-screenshots.ts",
    "memoire:capture": "node scripts/capture-memoire-screenshots.mjs",
    "memoire:align": "python3 scripts/align-memoire-bou.py",
    "memoire:pdf": "libreoffice --headless --convert-to pdf MEMOIRE_bou_aligne.docx --outdir .",
    "memoire:build": "npm run memoire:prepare && npm run memoire:capture && npm run memoire:align && npm run memoire:pdf",
    "demo:prepare": "tsx scripts/prepare-demo-soutenance.ts",
    "demo:record": "node scripts/record-demo-soutenance.mjs",
    "demo:soutenance": "npm run demo:prepare && npm run demo:record",
    "demo:complete:prepare": "tsx scripts/prepare-demo-complete.ts",
    "demo:complete:record": "node scripts/record-demo-complete.mjs",
    "demo:complete": "npm run demo:complete:prepare && DEMO_BASE_URL=https://application-demande-document-academ.vercel.app npm run demo:complete:record",
    "demo:video:prepare": "tsx scripts/prepare-demo-video-state.ts",
    "demo:video:record": "node scripts/record-demo-soutenance-propre.mjs",
    "demo:video": "npm run demo:video:prepare && DEMO_BASE_URL=https://application-demande-document-academ.vercel.app DEMO_PAUSE_MS=2200 npm run demo:video:record"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.3",
    "eslint": "^10",
    "eslint-config-next": "^16.2.10",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7"
  }
}
