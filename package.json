{
  "name": "nextjs-supabase-prisma-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:clean": "rm -rf .next && next dev -H 0.0.0.0",
    "build": "next build",
    "vercel-build": "prisma generate && next build && node scripts/copy-prisma-engines.mjs",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "export:disponibilisation-csv": "tsx scripts/export-disponibilisation-csv.ts",
    "generate:demo-csv": "node scripts/generate-demo-csv-by-region.mjs",
    "export:docs-pdf": "bash scripts/export-all-docs-pdf.sh",
    "seed:soutenance-eleves": "tsx scripts/seed-soutenance-eleves.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:centre-agents": "tsx scripts/seed-centre-examen-agents.ts",
    "seed:decc-admins": "tsx scripts/seed-decc-regional-admins.ts",
    "seed:regional-admins": "tsx scripts/seed-regional-admins.ts",
    "seed:regions": "tsx scripts/seed-region-access.ts",
    "seed:test-auth": "tsx scripts/seed-auth-test-user.ts",
    "seed:appointments": "tsx scripts/seed-appointments.ts",
    "prisma:seed": "tsx scripts/seed-diplomes.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "diagrams:export-v3": "bash scripts/export-diagrams-v3.sh",
    "diagrams:classes-soutenance": "node scripts/generate-conform-diagrams.mjs --classes-soutenance",
    "diagrams:conform": "node scripts/generate-conform-diagrams.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.1",
    "eslint": "^10",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6"
  }
}
